<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Messages Famille</title>

    <style>

        body{
            font-family: Arial;
            background:#f2f2f2;
            padding:20px;
        }

        h1{
            text-align:center;
        }

        #messages{
            background:white;
            height:400px;
            overflow-y:auto;
            border-radius:10px;
            padding:15px;
            border:1px solid #ccc;
            margin-bottom:20px;
        }

        .message{
            background:#e9e9e9;
            padding:10px;
            margin-bottom:10px;
            border-radius:8px;
        }

        form{
            display:flex;
            gap:10px;
        }

        input{
            flex:1;
            padding:12px;
            border:1px solid #ccc;
            border-radius:8px;
        }

        button{
            padding:12px 20px;
            border:none;
            background:#007bff;
            color:white;
            border-radius:8px;
            cursor:pointer;
        }

    </style>

</head>
<body>

<h1>Chat de la Famille</h1>

<div id="messages">

    <% if(messages && messages.length > 0){ %>

        <% messages.forEach(msg => { %>

            <div class="message">
                <%= msg %>
            </div>

        <% }) %>

    <% } %>

</div>

<form id="chat-form">

    <input
        type="text"
        id="message-input"
        placeholder="Écrivez un message..."
        autocomplete="off"
    >

    <button type="submit">
        Envoyer
    </button>

</form>

<!-- SOCKET.IO -->
<script src="/socket.io/socket.io.js"></script>

<script>

    const socket = io();

    const form = document.getElementById("chat-form");

    const input = document.getElementById("message-input");

    const messagesDiv = document.getElementById("messages");

    // ENVOYER MESSAGE
    form.addEventListener("submit", (e) => {

        e.preventDefault();

        const message = input.value.trim();

        if(message === ""){
            return;
        }

        socket.emit("chat message", message);

        input.value = "";

    });

    // RECEVOIR MESSAGE
    socket.on("chat message", (msg) => {

        const div = document.createElement("div");

        div.classList.add("message");

        div.innerText = msg;

        messagesDiv.appendChild(div);

        messagesDiv.scrollTop = messagesDiv.scrollHeight;

    });

</script>

</body>
</html>