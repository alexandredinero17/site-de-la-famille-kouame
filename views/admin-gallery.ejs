<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Admin Galerie</title>

    <style>

        body{
            font-family: Arial;
            background:#111b21;
            color:white;
            padding:20px;
        }

        .card{
            background:#202c33;
            padding:15px;
            margin-bottom:20px;
            border-radius:10px;
            width:250px;
        }

        img{
            width:100%;
            border-radius:10px;
        }

        button{
            margin-top:10px;
            width:100%;
            padding:10px;
            border:none;
            border-radius:8px;
            background:red;
            color:white;
            cursor:pointer;
        }

    </style>

</head>
<body>

<h1>Gestion Galerie</h1>

<% if(images.length > 0){ %>

    <% images.forEach(image => { %>

        <div class="card" id="img-<%= image.id %>">

            <img src="<%= image.image %>">

            <form action="/delete-image/<%= image.id %>" method="POST">

                <button
                    type="submit"
                    onclick="return confirm('Supprimer cette image ?')"
                >
                    Supprimer
                </button>

            </form>

        </div>

    <% }) %>

<% } else { %>

    <p>Aucune image</p>

<% } %>

</body>
</html>