<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Admin Events</title>
</head>
<body>

<h1>Gestion des événements</h1>

<% if(events.length > 0){ %>

    <% events.forEach(event => { %>

        <div style="border:1px solid #ccc;padding:10px;margin:10px;">

            <h3><%= event.title %></h3>

            <p><%= event.description %></p>

        </div>
<form action="/delete-event/<%= event.id %>" method="POST" onclick="return confirm('Supprimer cet événement ?')">
    <button type="submit">
        Supprimer
    </button>
</form>

    <% }) %>

<% } else { %>

<p>Aucun événement</p>

<% } %>

</body>
</html>