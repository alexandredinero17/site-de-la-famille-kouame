<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Admin Events</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Arial;
            background:#0b141a;
            color:white;
            padding:30px;
        }

        h1{
            margin-bottom:30px;
            font-size:32px;
        }

        .events-container{
            display:grid;
            grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
            gap:20px;
        }

        .event-card{

            background:#202c33;

            border-radius:20px;

            padding:20px;

            position:relative;

            overflow:hidden;

            transition:0.3s;

            border:1px solid rgba(255,255,255,0.05);

            animation:fadeIn 0.4s ease;
        }

        .event-card:hover{

            transform:translateY(-5px) scale(1.01);

            box-shadow:0 10px 25px rgba(0,0,0,0.4);
        }

        .event-card::before{

            content:"";

            position:absolute;

            top:0;
            left:0;

            width:100%;
            height:4px;

            background:#00a884;
        }

        .event-title{

            font-size:22px;

            color:#00d5a5;

            margin-bottom:15px;

            font-weight:bold;
        }

        .event-description{

            color:#ddd;

            line-height:1.6;

            margin-bottom:20px;

            word-wrap:break-word;
        }

        .event-date{

            color:#888;

            font-size:13px;

            margin-bottom:15px;
        }

        .delete-btn{

            width:100%;

            padding:12px;

            border:none;

            border-radius:12px;

            background:#ff3b30;

            color:white;

            font-weight:bold;

            cursor:pointer;

            transition:0.3s;
        }

        .delete-btn:hover{

            background:#ff1f12;

            transform:scale(1.02);
        }

        .empty{

            background:#202c33;

            padding:30px;

            border-radius:15px;

            text-align:center;

            color:#aaa;
        }

        @keyframes fadeIn{

            from{
                opacity:0;
                transform:translateY(15px);
            }

            to{
                opacity:1;
                transform:translateY(0);
            }
        }

    </style>

</head>
<body>

<h1>Gestion des événements</h1>

<% if(events.length > 0){ %>

<div class="events-container">

    <% events.forEach(event => { %>

        <div class="event-card" id="event-<%= event.id %>">

            <div class="event-title">
                <%= event.title %>
            </div>

            <div class="event-description">
                <%= event.description %>
            </div>

            <div class="event-date">
                <%= event.date || "" %>
            </div>

            <form
                action="/delete-event/<%= event.id %>"
                method="POST"
            >

                <button
                    class="delete-btn"
                    type="submit"
                    onclick="return confirm('Supprimer cet événement ?')"
                >
                    Supprimer
                </button>

            </form>

        </div>

    <% }) %>

</div>

<% } else { %>

<div class="empty">

    Aucun événement

</div>

<% } %>

</body>
</html>