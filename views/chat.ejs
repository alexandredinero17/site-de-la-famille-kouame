<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Chat</title>

<script src="/socket.io/socket.io.js"></script>

<style>
body{
    margin:0;
    font-family:Arial;
    background:#0b141a;
    color:white;
}

.header{
    background:#202c33;
    padding:15px;
    display:flex;
    align-items:center;
    gap:15px;
}

.avatar{
    width:50px;
    height:50px;
    border-radius:50%;
    object-fit:cover;
}

.messages{
    height:calc(100vh - 140px);
    overflow-y:auto;
    padding:20px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.message{
    max-width:70%;
    padding:12px;
    border-radius:15px;
    word-wrap:break-word;
}

.me{
    align-self:flex-end;
    background:#00a884;
}

.other{
    align-self:flex-start;
    background:#202c33;
}

.form{
    display:flex;
    gap:10px;
    padding:15px;
    background:#202c33;
}

input{
    flex:1;
    padding:12px;
    border:none;
    border-radius:30px;
    outline:none;
}

button{
    border:none;
    background:#00a884;
    color:white;
    padding:12px 20px;
    border-radius:30px;
    cursor:pointer;
}
button:onclick{
    background:#000000;
}

#typingStatus{
    font-size:12px;
    opacity:0.7;
}

#notif-count{
    background:red;
    border-radius:50%;
    padding:4px 8px;
    font-size:12px;
    display:none;
}
</style>
</head>

<body>

<a href="/">Accueil</a>

<a href="/conversations">
💬 Conversations
<span id="notif-count">0</span>
</a>

<div class="header">
    <img class="avatar" src="<%= membre.photo %>">

    <div>
        <h3><%= membre.nom %></h3>

        <div id="statusUser">
            <%= membre.online ? '🟢 En ligne' : '⚫ Hors ligne' %>
        </div>

        <div id="typingStatus"></div>
    </div>
</div>

<!-- MESSAGES -->
<div class="messages" id="messages">

<% messages.forEach(msg => { %>

    <div class="message <%= msg.sender_id === user.id ? 'me' : 'other' %>">

        <% if(msg.image){ %>
            <img src="<%= msg.image %>" style="max-width:200px;border-radius:10px;">
        <% } %>

        <% if(msg.message){ %>
            <div><%= msg.message %></div>
        <% } %>

<% if(msg.seen_count > 0){ %>
✔✔
<% } else { %>
✔
<% } %>

<% if(msg.audio){ %>

<audio controls>
    <source src="<%= msg.audio %>">
</audio>

<% } %>

    </div>

<% }) %>
</div>

<!-- INPUT -->
<div class="form">

    <input
        id="msg"
        type="text"
        placeholder="Votre message..."
    >

    <!-- IMAGE -->
    <input
        type="file"
        id="imageFile, audioFile"
        accept="image/*,audio/*"
    >

    <!-- MICRO -->
    <button
        type="button"
        id="recordBtn">
        🎤Enregistrer
    </button>

    <button
        type="button"
        onclick="sendMessage()">
        Envoyer
    </button>

</div>

<script>

const socket = io();

const conversationId = "<%= conversationId %>";
const userId = "<%= user.id %>";
const receiverId = "<%= membre.id %>";

const input = document.getElementById("msg");
const messagesBox = document.getElementById("messages");


socket.on("new_notification", (data) => {

    if (seenNotifications.has(data.messageId)) return;

    seenNotifications.add(data.messageId);

    notifCount++;

    const badge = document.getElementById("notif-count");

    badge.style.display = "inline-block";
    badge.innerText = notifCount;

    if (Notification.permission === "granted") {

        new Notification("Nouveau message", {
            body: data.message
        });

    }

    const audio = new Audio("/sounds/song.mp3");
    audio.play().catch(() => {});
});
const seenNotifications = new Set();
let notifCount = 0;

// scroll bas
window.onload = () => {
    messagesBox.scrollTop = messagesBox.scrollHeight;
};
let mediaRecorder;
let audioChunks = [];

const recordBtn =
document.getElementById("recordBtn");

recordBtn.addEventListener("click", async () => {

    if(!mediaRecorder ||
       mediaRecorder.state === "inactive"){

        const stream =
        await navigator.mediaDevices.getUserMedia({
            audio:true
        });

        mediaRecorder =
        new MediaRecorder(stream);

        audioChunks = [];

        mediaRecorder.ondataavailable =
        e => {
            audioChunks.push(e.data);
        };

        mediaRecorder.onstop = async () => {

            const blob =
            new Blob(audioChunks,{
                type:"audio/webm"
            });

            const formData =
            new FormData();

            formData.append(
                "audio",
                blob,
                "voice.webm"
            );

            formData.append(
                "conversation_id",
                conversationId
            );

            formData.append(
                "sender_id",
                userId
            );

            await fetch(
                "/upload-voice",
                {
                    method:"POST",
                    body:formData
                }
            );

        };

        mediaRecorder.start();

        recordBtn.innerHTML = "⏹️";

    }else{

        mediaRecorder.stop();

        recordBtn.innerHTML = "🎤";
    }

});

// JOIN
socket.emit("join_conversation", conversationId);
socket.emit("join_user", userId);

socket.emit("user_online", userId);

// MARK SEEN (CORRIGÉ)
socket.emit("mark_seen", {
    conversationId,
    userId
});


// OFFLINE
window.addEventListener("beforeunload", () => {
    socket.emit("user_offline", userId);
});

// --------------------
// TYPING
// --------------------
let timer;

input.addEventListener("input", () => {

    socket.emit("typing", {
        conversation_id: conversationId
    });

    clearTimeout(timer);

    timer = setTimeout(() => {

        socket.emit("stop_typing", {
            conversation_id: conversationId
        });

    }, 1500);

});

// --------------------
// ENVOI MESSAGE
// --------------------
function sendMessage(){

    const message = input.value.trim();
    const imageFile = document.getElementById("imageFile").files[0];
    const audioFile = document.getElementById("audioFile").files[0];

    if(!message && !imageFile && !audioFile) return;

    // IMAGE
    if(imageFile){

        const formData = new FormData();
        formData.append("image", file);
        formData.append("conversation_id", conversationId);
        formData.append("sender_id", userId);
        formData.append("message", message);

        fetch("/upload-chat-image", {
            method: "POST",
            body: formData
        });

        input.value = "";
        document.getElementById("imageFile").value = "";
        return;
    }

    // TEXTE
    socket.emit("send_message", {
        conversation_id: conversationId,
        sender_id: userId,
        message
    });

    input.value = "";
}

// ENTER
input.addEventListener("keypress", (e) => {
    if(e.key === "Enter") sendMessage();
});

// --------------------
// RECEIVE MESSAGE
// --------------------
socket.on("receive_message", (data) => {

    const div = document.createElement("div");

    div.className =
        "message " + (data.sender_id == userId ? "me" : "other");

    if(data.image){
        const img = document.createElement("img");
        img.src = data.image;
        img.style.maxWidth = "200px";
        img.style.borderRadius = "10px";
        div.appendChild(img);
    }

    if(data.message){
        const text = document.createElement("div");
        text.innerText = data.message;
        div.appendChild(text);
    }

    messagesBox.appendChild(div);
    messagesBox.scrollTop = messagesBox.scrollHeight;
});

// --------------------
// TYPING DISPLAY
// --------------------
socket.on("typing", () => {
    document.getElementById("typingStatus").innerText = "En train d'écrire...";
});

socket.on("stop_typing", () => {
    document.getElementById("typingStatus").innerText = "";
});

// --------------------
// ONLINE STATUS
// --------------------
socket.on("user_status", (data) => {

    if(data.userId == receiverId){

        document.getElementById("statusUser").innerText =
            data.online ? "🟢 En ligne" : "⚫ Hors ligne";
    }
});

socket.on("message_deleted", data => {

    const el = document.getElementById(
        "msg-" + data.message_id
    );

    if(el){
        el.innerHTML = "Message supprimé";
    }
});

socket.on("message_edited", data => {

    const text = document.querySelector(
        "#msg-" + data.message_id + " .text"
    );

    if(text){
        text.innerText = data.new_text;
    }
});
socket.on("messages_seen_update", () => {
});

window.addEventListener("focus", () => {

    notifCount = 0;

    const badge =
        document.getElementById("notif-count");

    badge.style.display = "none";

});

</script>

</body>
</html>