<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Famille Chat</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#111b21;
    height:100vh;
    overflow:hidden;
}

/* ================= HEADER ================= */

.chat-header{

    position:fixed;
    top:0;
    left:0;
    right:0;

    height:70px;

    background:#202c33;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 15px;

    border-bottom:1px solid rgba(255,255,255,.05);

    z-index:999;
}

.header-left{
    display:flex;
    align-items:center;
    gap:12px;
}

.back-btn{

    color:#aebac1;
    font-size:20px;
    text-decoration:none;
}

.header-left img{

    width:45px;
    height:45px;

    border-radius:50%;
    object-fit:cover;
}

.user-info h3{
    color:white;
    font-size:16px;
}

.user-info span{
    color:#8696a0;
    font-size:12px;
}

.header-icons{
    display:flex;
    align-items:center;
    gap:20px;
}

.header-icons i{
    color:#aebac1;
    font-size:18px;
    cursor:pointer;
}

/* ================= CHAT BOX ================= */

#chat-box{

    position:fixed;

    top:70px;
    bottom:75px;

    left:0;
    right:0;

    overflow-y:auto;

    padding:20px 12px;

    display:flex;
    flex-direction:column;

    gap:10px;

    background:#0b141a;

    background-image:
    url("https://i.imgur.com/3QZQZ9o.png");

    background-size:cover;

    scroll-behavior:smooth;
}

/* ================= MESSAGE ================= */

.msg{

    max-width:75%;

    padding:8px 10px 6px 10px;

    border-radius:10px;

    position:relative;

    animation:fade .2s ease;

    word-wrap:break-word;

    box-shadow:0 1px 1px rgba(0,0,0,.2);
}

/* MES MESSAGES */

.me{

    align-self:flex-end;

    background:#005c4b;

    border-top-right-radius:0;
}

/* AUTRES */

.other{

    align-self:flex-start;

    background:#202c33;

    border-top-left-radius:0;
}

.username{

    display:block;

    font-size:12px;

    margin-bottom:4px;

    font-weight:bold;

    color:#53bdeb;
}

.text{

    color:white;

    font-size:15px;

    line-height:1.5;
}

.time{

    display:flex;

    justify-content:flex-end;

    align-items:center;

    gap:5px;

    margin-top:4px;

    font-size:11px;

    color:#c7d0d5;
}

.seen{
    color:#53bdeb;
}

/* ================= INPUT ================= */

.chat-input{

    position:fixed;

    bottom:0;
    left:0;
    right:0;

    height:75px;

    background:#202c33;

    display:flex;
    align-items:center;

    gap:10px;

    padding:10px;
}

.chat-input i{

    color:#8696a0;

    font-size:22px;

    cursor:pointer;
}

.chat-input input{

    flex:1;

    height:45px;

    border:none;
    outline:none;

    border-radius:30px;

    padding:0 20px;

    background:#2a3942;

    color:white;

    font-size:15px;
}

.chat-input input::placeholder{
    color:#8696a0;
}

.send-btn{

    width:45px;
    height:45px;

    border:none;

    border-radius:50%;

    background:#00a884;

    color:white;

    font-size:18px;

    cursor:pointer;

    transition:.2s;
}

.send-btn:hover{
    transform:scale(1.05);
}

/* ================= SCROLL ================= */

#chat-box::-webkit-scrollbar{
    width:5px;
}

#chat-box::-webkit-scrollbar-thumb{
    background:#2a3942;
    border-radius:10px;
}

/* ================= ANIMATION ================= */

@keyframes fade{

    from{
        opacity:0;
        transform:translateY(10px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* ================= MOBILE ================= */

@media(max-width:700px){

    .msg{
        max-width:90%;
    }

    .header-icons{
        gap:14px;
    }

    .header-left img{
        width:40px;
        height:40px;
    }
}

</style>
</head>

<body>

<!-- ================= HEADER ================= -->

<div class="chat-header">

    <div class="header-left">

        <a href="/conversations" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <img src="<%= otherUser.photo || '/images/default.png' %>">

        <div class="user-info">

            <h3>
                <%= otherUser.nom %>
            </h3>

            <span>
                @<%= otherUser.user_name %>
            </span>

        </div>

    </div>

    <div class="header-icons">

        <i class="fa-solid fa-video"></i>

        <i class="fa-solid fa-phone"></i>

        <i class="fa-solid fa-ellipsis-vertical"></i>

    </div>

</div>

<!-- ================= CHAT ================= -->

<div id="chat-box">

<% messages.forEach(m => { %>

<div class="msg <%= m.sender_username === user.user_name ? 'me' : 'other' %>">

    <span class="username">
        @<%= m.sender_username %>
    </span>

    <div class="text">
        <%= m.message %>
    </div>

    <div class="time">

        <span>

            <%= new Date(m.created_at).toLocaleTimeString([], {
                hour:'2-digit',
                minute:'2-digit'
            }) %>

        </span>

        <% if(m.sender_username === user.user_name){ %>

            <span class="seen">
                ✓✓
            </span>

        <% } %>

    </div>

</div>

<% }) %>

</div>

<!-- ================= INPUT ================= -->

<div class="chat-input">

    <i class="fa-regular fa-face-smile"></i>

    <i class="fa-solid fa-paperclip"></i>

    <input
        type="text"
        id="msg"
        placeholder="Écrire un message..."
        autocomplete="off"
    >

    <button
        class="send-btn"
        onclick="sendMessage()"
    >
        <i class="fa-solid fa-paper-plane"></i>
    </button>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const roomId = Number("<%= roomId %>");

socket.emit("join", roomId);
socket.emit("user_online", "<%= user.id %>");

const chatBox = document.getElementById("chat-box");

function scrollBottom(){

    chatBox.scrollTop = chatBox.scrollHeight;
}

scrollBottom();

function getTime(){

    const now = new Date();

    return now.toLocaleTimeString([], {

        hour:'2-digit',
        minute:'2-digit'

    });
}

// ================= SEND =================

function sendMessage(){

    const input = document.getElementById("msg");

    const msg = input.value.trim();

    if(!msg) return;

    socket.emit("message", {

        conversationId: roomId,

        sender_username: "<%= user.user_name %>",

        message: msg
    });

    input.value = "";
}

// ================= ENTER =================

input.addEventListener("input", () => {
    socket.emit("typing", {
        conversationId,
        userId,
        isTyping: true
    });
});
chatBox.addEventListener("scroll", () => {

    socket.emit("message_seen", {
        messageId: lastMessageId,
        userId
    });

});


// ================= RECEIVE =================

socket.on("message", (data) => {

    const div = document.createElement("div");

    div.classList.add("msg");

    if(data.sender_username === "<%= user.user_name %>"){

        div.classList.add("me");

    }else{

        div.classList.add("other");
    }

    div.innerHTML = `

        <span class="username">
            @${data.sender_username}
        </span>

        <div class="text">
            ${data.message}
        </div>

        <div class="time">

            <span>${getTime()}</span>

            ${
                data.sender_username === "<%= user.user_name %>"
                ? '<span class="seen">✓✓</span>'
                : ''
            }

        </div>
    `;

    chatBox.appendChild(div);

    scrollBottom();
});


</script>

</body>
</html>