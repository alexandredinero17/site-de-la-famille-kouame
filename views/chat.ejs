<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Chat</title>

<style>

body {
    font-family: Arial;
    background: #0b141a;
    color: white;
    margin: 0;
}

/* HEADER */
h3 {
    padding: 10px;
    background:#202c33;
    margin:0;
}

/* CHAT BOX */
#chat-box {
    height: 80vh;
    overflow-y: auto;
    padding: 10px;
    display:flex;
    flex-direction:column;
}

/* MESSAGE */
.msg {
    padding: 10px;
    margin: 5px;
    border-radius: 10px;
    max-width: 60%;
    word-wrap: break-word;
}

/* MY MESSAGE */
.me {
    background: #005c4b;
    margin-left: auto;
}

/* OTHER */
.other {
    background: #202c33;
}

/* INPUT BAR */
#input {
    display: flex;
    position: fixed;
    bottom: 0;
    width: 100%;
    background: #111;
    padding: 10px;
}

#msg {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 20px;
    outline:none;
}

button {
    margin-left: 10px;
    background: #00a884;
    border: none;
    padding: 10px 15px;
    border-radius: 20px;
    color: white;
    cursor: pointer;
}
#status{
    text-align:center;
    font-size:12px;
    color:#aaa;
    padding:5px;
}

/* SCROLL SMOOTH */
#chat-box{
    scroll-behavior:smooth;
}

/* MESSAGE TIME STYLE */
.msg div{
    margin-top:5px;
}
</style>
</head>

<body>

<h3>
    Chat avec la famille
</h3>

<div id="status"></div>

<div id="chat-box"></div>

<div id="input">
    <input id="msg" placeholder="Message..." />
    <button onclick="sendMessage()">Envoyer</button>
</div>
<script src="/socket.io/socket.io.js"></script>

<script>
const socket = io();

// rejoindre room
socket.emit("joinRoom", "<%= roomId %>");

// envoyer message
function sendMessage() {

    const msg = document.getElementById("msg").value;

    if (!msg.trim()) return;

    socket.emit("sendMessage", {
        roomId: "<%= roomId %>",
        message: msg,
        sender: "<%= user.nom %>"
    });

    document.getElementById("msg").value = "";
}

// recevoir message
socket.on("newMessage", (data) => {

    const chat = document.getElementById("chat-box");

    const div = document.createElement("div");

    div.classList.add("msg");

    if (data.sender === "<%= user.nom %>") {
        div.classList.add("me");
    } else {
        div.classList.add("other");
    }

    div.innerHTML = `
        <b>${data.sender}</b><br>
        ${data.message}
    `;

    chat.appendChild(div);

    chat.scrollTop = chat.scrollHeight;
});
/* 🔔 NOTIFICATION PRO */
socket.on("notification", (data) => {

    showNotification("📩 " + data.sender + " a envoyé un message");

});

/* NOTIFICATION SYSTEM (PRO) */
function showNotification(text) {

    // badge visuel simple
    const status = document.getElementById("status");

    status.innerText = text;
    status.style.background = "#00a884";
    status.style.padding = "5px";
    status.style.borderRadius = "5px";

    setTimeout(() => {
        status.innerText = "";
        status.style.background = "none";
    }, 3000);
}

/* 🔥 TYPING SYSTEM */
let typingTimeout;

document.getElementById("msg").addEventListener("input", () => {

    socket.emit("typing", { roomId: "<%= roomId %>", user: "<%= user.nom %>" });

    clearTimeout(typingTimeout);

    typingTimeout = setTimeout(() => {
        socket.emit("stopTyping", { roomId: "<%= roomId %>", user: "<%= user.nom %>" });
    }, 1000);

});

socket.on("typing", (data) => {

    document.getElementById("status").innerText =
        data.user + " est en train d'écrire...";

});

socket.on("stopTyping", () => {
    document.getElementById("status").innerText = "";
});

/* 🟢 ONLINE STATUS */
socket.on("userStatus", (data) => {

    console.log(data.user + " : " + data.status);

});

</script>
</body>
</html>