<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Chat</title>

<style>

body{
    background:#0b141a;
    color:white;
    font-family:Arial;
    margin:0;
}

.header{
    background:#202c33;
    padding:15px;
    display:flex;
    align-items:center;
    gap:15px;
}

.avatar{
    width:50px;
    height:50px;
    border-radius:50%;
    object-fit:cover;
}

.messages{
    height:70vh;
    padding:20px;
}

.form{
    position:fixed;
    bottom:0;
    width:100%;
    background:#202c33;
    padding:15px;
    display:flex;
    gap:10px;
}

input{
    flex:1;
    padding:12px;
    border:none;
    border-radius:30px;
    outline:none;
}

button{
    background:#00a884;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:30px;
    cursor:pointer;
}

</style>

</head>
<body>
<script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();

const conversationId = "<%= conversation.id %>";
const userId = "<%= user.id %>";

socket.emit("join", conversationId);
function sendMessage() {

    const input = document.getElementById("msg");

    socket.emit("send_message", {
        conversation_id: conversationId,
        sender_id: userId,
        message: input.value
    });

    input.value = "";
}
socket.on("receive_message", (data) => {

    const div = document.createElement("div");

    div.innerHTML = data.message;

    document.getElementById("messages").appendChild(div);

});
</script>

<div class="header">

    <img class="avatar"
         src="<%= membre.photo %>">

    <div>

        <h3>
            <%= membre.nom %>
        </h3>

        <% if(membre.online){ %>
            <small style="color:#25D366;">En ligne</small>
        <% } else { %>
            <small style="color:gray;">Hors ligne</small>
        <% } %>

    </div>

</div>

<div class="messages" id="messages">

    <p>
        Conversation avec <%= membre.nom %>
    </p>

</div>

<form class="form">

   <input
    id="msg"
    type="text"
    placeholder="Votre message..."
>

   <button type="button" onclick="sendMessage()">
    Envoyer
</button>

</form>


</body>
</html>