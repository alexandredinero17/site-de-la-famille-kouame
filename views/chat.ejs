<!DOCTYPE html>
<html lang="fr">
<head>

<meta charset="UTF-8">

<title>Chat</title>

<script src="/socket.io/socket.io.js"></script>

<style>

body{
    margin:0;
    font-family:Arial;
    background:#0b141a;
    color:white;
}

.header{
    background:#202c33;
    padding:15px;
    display:flex;
    align-items:center;
    gap:15px;
}

.avatar{
    width:50px;
    height:50px;
    border-radius:50%;
    object-fit:cover;
}

.messages{
    height:calc(100vh - 140px);
    overflow-y:auto;
    padding:20px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.message{
    max-width:70%;
    padding:12px;
    border-radius:15px;
    word-wrap:break-word;
}

.me{
    align-self:flex-end;
    background:#00a884;
}

.other{
    align-self:flex-start;
    background:#202c33;
}

.form{
    display:flex;
    gap:10px;
    padding:15px;
    background:#202c33;
}

input{
    flex:1;
    padding:12px;
    border:none;
    border-radius:30px;
    outline:none;
}

button{
    border:none;
    background:#00a884;
    color:white;
    padding:12px 20px;
    border-radius:30px;
    cursor:pointer;
}
#notif-box{

    position:fixed;
    top:20px;
    right:20px;
    z-index:9999;

}

.notification{

    background:#202c33;
    color:white;
    padding:15px;
    border-radius:10px;
    margin-bottom:10px;
    min-width:250px;

}

#notif-count{

    background:red;
    color:white;

    border-radius:50%;

    padding:4px 8px;

    font-size:12px;

    display:none;

}
</style>

</head>
<button type="button" href="/">acceuil</button>
<div id="notif-box"></div>
<a href="/conversations">

    💬 Conversations

    <span id="notif-count">0</span>

</a>
<body>

<div class="header">

    <img class="avatar"
         src="<%= membre.photo %>">

    <div>

        <h3>
            <%= membre.nom %>
        </h3>

    </div>

</div>

<div class="messages" id="messages">

    <% messages.forEach(msg => { %>

        <div class="message <%= msg.sender_id === user.id ? 'me' : 'other' %>">

            <%= msg.message %>

        </div>

    <% }) %>

</div>

<div class="form">

    <input
        id="msg"
        type="text"
        placeholder="Votre message..."
    >

    <button onclick="sendMessage()">

        Envoyer

    </button>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const conversationId = "<%= conversationId %>";

const userId = "<%= user.id %>";

const receiverId = "<%= membre.id %>";

socket.emit(
    'join_conversation',
    conversationId
);

socket.emit(
    'join_user',
    userId
);


function sendMessage(){

    const input = document.getElementById('msg');

    const message = input.value.trim();
    

    if(message === '') return;

   socket.emit('send_message', {

    conversation_id: conversationId,
    sender_id: userId,
    receiver_id: receiverId,
    message

});

socket.on('new_notification', (data) => {

    notifCount++;

    const badge =
        document.getElementById('notif-count');

    badge.style.display = 'inline-block';

    badge.innerText = notifCount;

    // notification navigateur
    if (Notification.permission === 'granted') {

        new Notification(
            'Nouveau message',
            {
                body: data.message
            }
        );
    }
   // son
   const audio = new Audio(
    '/public/sounds/song.mp3'
);

audio.volume = 1;

audio.play().catch(err => {

    console.log("Erreur audio :", err);

});

});

// demander permission
if(Notification.permission !== 'granted'){

    Notification.requestPermission();

}
socket.on('receive_message', (data) => {

    const div = document.createElement('div');

    div.className =
        'message ' +
        (data.sender_id === userId ? 'me' : 'other');

    div.innerText = data.message;

    document
    .getElementById('messages')
    .appendChild(div);

});
}

</script>

</body>
</html>
