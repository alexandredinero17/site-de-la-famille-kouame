<!DOCTYPE html>
<html lang="fr">
<head>

<meta charset="UTF-8">

<title>Chat</title>

<script src="/socket.io/socket.io.js"></script>

<style>

body{
    margin:0;
    font-family:Arial;
    background:#0b141a;
    color:white;
}

.header{
    background:#202c33;
    padding:15px;
    display:flex;
    align-items:center;
    gap:15px;
}

.avatar{
    width:50px;
    height:50px;
    border-radius:50%;
    object-fit:cover;
}

.messages{
    height:calc(100vh - 140px);
    overflow-y:auto;
    padding:20px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.message{
    max-width:70%;
    padding:12px;
    border-radius:15px;
    word-wrap:break-word;
}

.me{
    align-self:flex-end;
    background:#00a884;
}

.other{
    align-self:flex-start;
    background:#202c33;
}

.form{
    display:flex;
    gap:10px;
    padding:15px;
    background:#202c33;
}

input{
    flex:1;
    padding:12px;
    border:none;
    border-radius:30px;
    outline:none;
}

button{
    border:none;
    background:#00a884;
    color:white;
    padding:12px 20px;
    border-radius:30px;
    cursor:pointer;
}
#notif-box{

    position:fixed;
    top:20px;
    right:20px;
    z-index:9999;

}

.notification{

    background:#202c33;
    color:white;
    padding:15px;
    border-radius:10px;
    margin-bottom:10px;
    min-width:250px;

}

#notif-count{

    background:red;
    color:white;

    border-radius:50%;

    padding:4px 8px;

    font-size:12px;

    display:none;

}
</style>

</head>

<body>

<a href="/">Accueil</a>

<div id="notif-box"></div>

<a href="/conversations">

    💬 Conversations

    <span id="notif-count">0</span>

</a>

<div class="header">

    <img class="avatar"
         src="<%= membre.photo %>">

    <div>

        <h3>
            <%= membre.nom %>
        </h3>
        <div id="statusUser">
<%= membre.online ? '🟢 En ligne' : '⚫ Hors ligne' %>
</div>

<div id="typingStatus"></div>

    </div>

</div>
<div class="message <%= msg.sender_id === user.id ? 'me' : 'other' %>">

    <% if(msg.image){ %>

<img
    src="<%= msg.image %>"
    style="
    max-width:250px;
    border-radius:10px;
    display:block;
    margin-bottom:5px;
">

<% } %>
<% if(msg.image){ %>

    <img src="<%= msg.image %>" style="max-width:200px;border-radius:10px;">

<% } %>

<% if(msg.message){ %>
    <div><%= msg.message %></div>
<% } %>

    <% if(msg.sender_id === user.id){ %>

        <small>

            <%= msg.seen ? '✓✓' : '✓' %>

        </small>
        <% if(msg.seen_at){ %>

<small>

Vu le
<%= new Date(msg.seen_at)
.toLocaleString('fr-FR') %>

</small>

<% } %>

    <% } %>

</div>

<div class="form">

  <input
    id="msg"
    type="text"
    placeholder="Votre message..."
>

<input
    type="file"
    id="imageFile"
    accept="image/*"
>

    <button onclick="sendMessage()">

        Envoyer

    </button>

</div>
<script>

const socket = io();

const conversationId = "<%= conversationId %>";
const userId = "<%= user.id %>";
const receiverId = "<%= membre.id %>";

let notifCount = 0;

window.onload = () => {

    const messages =
    document.getElementById('messages');

    messages.scrollTop =
    messages.scrollHeight;

};

socket.emit('join_conversation', conversationId);
socket.emit(
    'mark_seen',
    conversationId,
    userId
);
socket.emit('join_user', userId);
socket.emit('user_online', userId);

window.addEventListener('beforeunload', () => {

    socket.emit(
        'user_offline',
        userId
    );

});

// --------------------
// EN TRAIN D'ÉCRIRE
// --------------------

const input =
document.getElementById('msg');

let typingTimer;

input.addEventListener('input', () => {

    socket.emit('typing', {

        conversation_id: conversationId,
        user_id: userId

    });

    clearTimeout(typingTimer);

    typingTimer = setTimeout(() => {

        socket.emit('stop_typing', {

            conversation_id: conversationId

        });

    }, 1000);

});

// --------------------
// ENVOI MESSAGE
// --------------------

function sendMessage(){

    const message = input.value.trim();
    const file = document.getElementById('imageFile').files[0];

    if(!message && !file) return;

    // si image
    if(file){

        const formData = new FormData();
        formData.append("image", file);
        formData.append("conversation_id", conversationId);
        formData.append("sender_id", userId);
        formData.append("message", message);

        fetch("/upload-chat-image", {
            method: "POST",
            body: formData
        });

        document.getElementById('imageFile').value = "";
        input.value = "";

        return;
    }

    // message texte simple
    socket.emit('send_message', {

        conversation_id: conversationId,
        sender_id: userId,
        message

    });

    input.value = '';
}

// envoi avec Entrée

input.addEventListener('keypress', function(e){

    if(e.key === 'Enter'){

        sendMessage();

    }

});
socket.on('messages_seen', () => {

    location.reload();

});

// --------------------
// RECEPTION MESSAGE
// --------------------

socket.on('receive_message', (data) => {

    const div =
    document.createElement('div');

    div.className =
    'message ' +
    (data.sender_id == userId
        ? 'me'
        : 'other');

   if(data.image){

    const img = document.createElement("img");
    img.src = data.image;
    img.style.maxWidth = "200px";
    img.style.borderRadius = "10px";

    div.appendChild(img);

}

if(data.message){

    const text = document.createElement("div");
    text.innerText = data.message;
    div.appendChild(text);

}

    document
    .getElementById('messages')
    .appendChild(div);

    document
    .getElementById('messages')
    .scrollTop =
    document
    .getElementById('messages')
    .scrollHeight;

});

// --------------------
// NOTIFICATIONS
// --------------------

socket.on('new_notification', (data) => {

    notifCount++;

    const badge =
    document.getElementById(
        'notif-count'
    );

    badge.style.display =
    'inline-block';

    badge.innerText =
    notifCount;

    if(
        Notification.permission
        === 'granted'
    ){

        new Notification(
            'Nouveau message',
            {
                body: data.message
            }
        );

    }

    const audio =
    new Audio(
        '/sounds/song.mp3'
    );

    audio.play().catch(() => {});

});

if(
    Notification.permission
    !== 'granted'
){

    Notification.requestPermission();

}

// --------------------
// TYPING
// --------------------

socket.on('typing', () => {

    document
    .getElementById(
        'typingStatus'
    )
    .innerText =
    'En train d\'écrire...';

});

socket.on('stop_typing', () => {

    document
    .getElementById(
        'typingStatus'
    )
    .innerText = '';

});

// --------------------
// ONLINE STATUS
// --------------------

socket.on(
    'user_status',
    (data) => {

        if(
            data.userId == receiverId
        ){

            document
            .getElementById(
                'statusUser'
            )
            .innerText =

            data.online
            ? '🟢 En ligne'
            : '⚫ Hors ligne';

        }

    }
);

</script>

</body>
</html>
