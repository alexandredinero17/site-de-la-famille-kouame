<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Chat</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#0b141a;
    color:white;
    height:100vh;
    overflow:hidden;
}

/* HEADER */
h3{
    background:rgba(32,44,51,.95);
    backdrop-filter:blur(10px);
    padding:18px;
    font-size:18px;
    border-bottom:1px solid rgba(255,255,255,.08);
    box-shadow:0 2px 10px rgba(0,0,0,.3);
}

/* CHAT */
#chat-box{
    height:calc(100vh - 80px);
    overflow-y:auto;
    padding:20px;
    display:flex;
    flex-direction:column;
    gap:10px;
    scroll-behavior:smooth;
}

/* MESSAGE */
.msg{
    padding:12px 14px;
    border-radius:18px;
    max-width:70%;
    animation:fadeIn .25s ease;
    position:relative;
    box-shadow:0 4px 12px rgba(0,0,0,.2);
}

/* MY MESSAGE */
.me{
    background:linear-gradient(135deg,#00a884,#005c4b);
    margin-left:auto;
    border-bottom-right-radius:5px;
}

/* OTHER MESSAGE */
.other{
    background:#202c33;
    margin-right:auto;
    border-bottom-left-radius:5px;
}

/* USERNAME */
.msg b{
    display:block;
    margin-bottom:5px;
    font-size:13px;
    opacity:.8;
}

/* TIME */
.time{
    display:block;
    text-align:right;
    margin-top:6px;
    font-size:11px;
    opacity:.7;
}

/* INPUT BAR */
#input{
    position:fixed;
    bottom:0;
    width:100%;
    display:flex;
    padding:12px;
    background:#111b21;
    border-top:1px solid rgba(255,255,255,.05);
}

/* INPUT */
#msg{
    flex:1;
    border:none;
    outline:none;
    padding:14px;
    border-radius:30px;
    background:#202c33;
    color:white;
    font-size:15px;
}

/* BUTTON */
button{
    margin-left:10px;
    border:none;
    background:linear-gradient(135deg,#00a884,#008069);
    color:white;
    padding:12px 18px;
    border-radius:50px;
    cursor:pointer;
    font-weight:bold;
    transition:.2s;
}

button:hover{
    transform:scale(1.05);
}

/* ANIMATION */
@keyframes fadeIn{

    from{
        opacity:0;
        transform:translateY(10px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* MOBILE */
@media(max-width:700px){

    .msg{
        max-width:90%;
    }

    h3{
        font-size:16px;
    }
}

</style>
</head>
<div id="input">

    <input
        type="text"
        id="msg"
        placeholder="Écrire un message..."
        autocomplete="off"
    >

    <button onclick="sendMessage()">
        Envoyer
    </button>

</div>
<body>

<h3>
    Chat avec la famille
</h3>
<div id="chat-box">

    <% messages.forEach(m => { %>
        <div class="msg <%= m.sender_username === user.username ? 'me' : 'other' %>">
            <b>@<%= m.sender_username %></b><br>
            <%= m.message %>
        </div>
    <% }) %>

</div>
<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const roomId = Number("<%= roomId %>");

socket.emit("join", roomId);

const chatBox = document.getElementById("chat-box");

function getTime() {

    const now = new Date();

    return now.toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit'
    });
}

// AUTO SCROLL
function scrollBottom(){

    chatBox.scrollTop = chatBox.scrollHeight;
}

scrollBottom();

// SEND MESSAGE
function sendMessage() {

    const input = document.getElementById("msg");

    const msg = input.value.trim();

    if(!msg) return;

    socket.emit("message", {

        conversationId: roomId,

        sender_username: "<%= user.username %>",

        message: msg
    });

    input.value = "";
}

// ENTER TO SEND
document
.getElementById("msg")
.addEventListener("keypress", function(e){

    if(e.key === "Enter"){

        sendMessage();
    }
});

// RECEIVE MESSAGE
socket.on("message", (data) => {

    const div = document.createElement("div");

    div.classList.add("msg");

    if(data.sender_username === "<%= user.username %>"){

        div.classList.add("me");

    }else{

        div.classList.add("other");
    }

    div.innerHTML = `
        <b>@${data.sender_username}</b>

        <div>${data.message}</div>

        <span class="time">
            ${getTime()}
        </span>
    `;

    chatBox.appendChild(div);

    scrollBottom();
});

</script>
</body>
</html>