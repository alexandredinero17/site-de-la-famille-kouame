<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Chat</title>

<style>

body {
    font-family: Arial;
    background: #0b141a;
    color: white;
    margin: 0;
}

/* HEADER */
h3 {
    padding: 10px;
    background:#202c33;
    margin:0;
}

/* CHAT BOX */
#chat-box {
    height: 80vh;
    overflow-y: auto;
    padding: 10px;
    display:flex;
    flex-direction:column;
}

/* MESSAGE */
.msg {
    padding: 10px;
    margin: 5px;
    border-radius: 10px;
    max-width: 60%;
    word-wrap: break-word;
}

/* MY MESSAGE */
.me {
    background: #005c4b;
    margin-left: auto;
}

/* OTHER */
.other {
    background: #202c33;
}

/* INPUT BAR */
#input {
    display: flex;
    position: fixed;
    bottom: 0;
    width: 100%;
    background: #111;
    padding: 10px;
}

#msg {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 20px;
    outline:none;
}

button {
    margin-left: 10px;
    background: #00a884;
    border: none;
    padding: 10px 15px;
    border-radius: 20px;
    color: white;
    cursor: pointer;
}
#status{
    text-align:center;
    font-size:12px;
    color:#aaa;
    padding:5px;
}

/* SCROLL SMOOTH */
#chat-box{
    scroll-behavior:smooth;
}

/* MESSAGE TIME STYLE */
.msg div{
    margin-top:5px;
}
</style>
</head>

<body>

<h3>
    Chat avec la famille
</h3>
<div id="chat-box">

    <% messages.forEach(m => { %>
        <div class="msg <%= m.sender_username === user.username ? 'me' : 'other' %>">
            <b>@<%= m.sender_username %></b><br>
            <%= m.message %>
        </div>
    <% }) %>

</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();

socket.emit("online", "<%= user.id %>");
socket.emit("join", "<%= roomId %>");

function sendMessage() {

    const msg = document.getElementById("msg").value;

    if (!msg.trim()) return;

    socket.emit("message", {
        conversationId: Number("<%= roomId %>"),
        sender_username: "<%= user.username %>",
        message: msg
    });

    document.getElementById("msg").value = "";
}

socket.on("message", (data) => {

    const chat = document.getElementById("chat-box");

    const div = document.createElement("div");
    div.classList.add(data.sender_username === "<%= user.username %>" ? "me" : "other");

    div.classList.add("msg");

    div.innerHTML = `
        <b>@${data.sender_username}</b><br>
        ${data.message}
    `;

    chat.appendChild(div);

    chat.scrollTop = chat.scrollHeight;
});
</script>
</body>
</html>