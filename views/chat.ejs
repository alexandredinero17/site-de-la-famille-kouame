<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Chat</title>

<style>

body {
    font-family: Arial;
    background: #0b141a;
    color: white;
    margin: 0;
}

/* HEADER */
h3 {
    padding: 10px;
    background:#202c33;
    margin:0;
}

/* CHAT BOX */
#chat-box {
    height: 80vh;
    overflow-y: auto;
    padding: 10px;
    display:flex;
    flex-direction:column;
}

/* MESSAGE */
.msg {
    padding: 10px;
    margin: 5px;
    border-radius: 10px;
    max-width: 60%;
    word-wrap: break-word;
}

/* MY MESSAGE */
.me {
    background: #005c4b;
    margin-left: auto;
}

/* OTHER */
.other {
    background: #202c33;
}

/* INPUT BAR */
#input {
    display: flex;
    position: fixed;
    bottom: 0;
    width: 100%;
    background: #111;
    padding: 10px;
}

#msg {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 20px;
    outline:none;
}

button {
    margin-left: 10px;
    background: #00a884;
    border: none;
    padding: 10px 15px;
    border-radius: 20px;
    color: white;
    cursor: pointer;
}
#status{
    text-align:center;
    font-size:12px;
    color:#aaa;
    padding:5px;
}

/* SCROLL SMOOTH */
#chat-box{
    scroll-behavior:smooth;
}

/* MESSAGE TIME STYLE */
.msg div{
    margin-top:5px;
}
</style>
</head>

<body>

<h3>
    Chat avec la famille
</h3>
<div id="chat-box"></div>

<div id="input">
    <input id="msg" placeholder="Message..." />
    <button onclick="sendMessage()">Envoyer</button>
</div>

<script src="/socket.io/socket.io.js"></script>

<script>
const socket = io();

socket.emit("online", "<%= user.id %>");
socket.emit("join", "<%= roomId %>");

function sendMessage() {

    socket.emit("message", {
        conversationId: "<%= roomId %>",
        sender_username: "<%= user.username %>",
        message: document.getElementById("msg").value
    });
}

socket.on("message", (data) => {

    const chat = document.getElementById("chat-box");

    chat.innerHTML += `
        <div>
            <b>@${data.sender_username}</b>: ${data.message}
        </div>
    `;
});
</script>

</body>
</html>