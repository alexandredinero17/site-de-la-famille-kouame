<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Messages Conversation</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Arial;
            background:#0b141a;
            color:white;
            padding:30px;
        }

        h1{
            margin-bottom:30px;
            font-size:32px;
        }

        .messages-container{
            display:flex;
            flex-direction:column;
            gap:20px;
        }

        .message-card{

            background:#202c33;

            border-radius:20px;

            padding:20px;

            position:relative;

            overflow:hidden;

            transition:0.3s;

            border:1px solid rgba(255,255,255,0.05);

            animation:fadeIn 0.4s ease;
        }

        .message-card:hover{

            transform:translateY(-4px);

            box-shadow:0 10px 25px rgba(0,0,0,0.4);
        }

        .message-card::before{

            content:"";

            position:absolute;

            top:0;
            left:0;

            width:100%;
            height:4px;

            background:#00a884;
        }

        .sender{

            font-size:20px;

            color:#00d5a5;

            font-weight:bold;

            margin-bottom:12px;
        }

        .content{

            color:#ddd;

            line-height:1.6;

            margin-bottom:15px;

            word-wrap:break-word;
        }

        .media{

            margin-top:10px;
            margin-bottom:15px;
        }

        .media img{

            width:220px;

            border-radius:15px;

            transition:0.3s;
        }

        .media img:hover{

            transform:scale(1.03);
        }

        .delete-btn{

            width:100%;

            padding:12px;

            border:none;

            border-radius:12px;

            background:#ff3b30;

            color:white;

            font-weight:bold;

            cursor:pointer;

            transition:0.3s;
        }

        .delete-btn:hover{

            background:#ff1f12;

            transform:scale(1.02);
        }

        .empty{

            background:#202c33;

            padding:30px;

            border-radius:15px;

            text-align:center;

            color:#aaa;
        }

        @keyframes fadeIn{

            from{
                opacity:0;
                transform:translateY(15px);
            }

            to{
                opacity:1;
                transform:translateY(0);
            }
        }

    </style>

</head>
<body>

<h1>📨 Messages de la conversation</h1>

<% if(messages.length > 0){ %>

<div class="messages-container">

    <% messages.forEach(m => { %>

        <div class="message-card" id="message-<%= m.id %>">

            <div class="sender">
                <%= m.sender %>
            </div>

            <div class="content">
                <%= m.content %>
            </div>

            <% if (m.media_url) { %>

                <div class="media">

                    <img src="<%= m.media_url %>">

                </div>

            <% } %>

            <form
                method="POST"
                action="/admin/delete-message/<%= m.id %>"
            >

                <button
                    class="delete-btn"
                    onclick="return confirm('Supprimer ce message ?')"
                >
                    Supprimer
                </button>

            </form>

        </div>

    <% }) %>

</div>

<% } else { %>

<div class="empty">

    Aucun message

</div>

<% } %>

</body>
</html>