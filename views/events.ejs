<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Événements</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Arial;
            background:#0b141a;
            color:white;
            padding:30px;
        }

        h2{
            margin-bottom:20px;
            font-size:30px;
        }

        /* FORM */

        .event-form{

            background:#202c33;

            padding:25px;

            border-radius:20px;

            margin-bottom:40px;

            animation:fadeIn 0.5s ease;
        }

        .event-form input{

            width:100%;

            padding:14px;

            margin-bottom:15px;

            border:none;

            border-radius:12px;

            background:#111b21;

            color:white;

            outline:none;

            font-size:15px;
        }

        .event-form input:focus{

            border:1px solid #00a884;
        }

        .event-form button{

            width:100%;

            padding:14px;

            border:none;

            border-radius:12px;

            background:#00a884;

            color:white;

            font-weight:bold;

            cursor:pointer;

            transition:0.3s;
        }

        .event-form button:hover{

            background:#00c79a;

            transform:scale(1.02);
        }

        /* EVENTS */

        .events-container{

            display:grid;

            grid-template-columns:repeat(auto-fill,minmax(320px,1fr));

            gap:20px;
        }

        .event-card{

            background:#202c33;

            border-radius:20px;

            padding:20px;

            position:relative;

            overflow:hidden;

            transition:0.3s;

            border:1px solid rgba(255,255,255,0.05);

            animation:fadeIn 0.5s ease;
        }

        .event-card:hover{

            transform:translateY(-5px);

            box-shadow:0 10px 25px rgba(0,0,0,0.4);
        }

        .event-card::before{

            content:"";

            position:absolute;

            top:0;
            left:0;

            width:100%;
            height:4px;

            background:#00a884;
        }

        .event-title{

            font-size:22px;

            color:#00d5a5;

            margin-bottom:15px;

            font-weight:bold;
        }

        .event-description{

            color:#ddd;

            line-height:1.6;

            margin-bottom:20px;
        }

        .event-user{

            color:#aaa;

            margin-bottom:10px;

            font-size:14px;
        }

        .event-date{

            color:#888;

            font-size:13px;
        }

        footer{

            margin-top:50px;

            text-align:center;

            color:#666;

            font-size:14px;
        }

        @keyframes fadeIn{

            from{
                opacity:0;
                transform:translateY(15px);
            }

            to{
                opacity:1;
                transform:translateY(0);
            }
        }
        #notif-count{

    background:red;
    color:white;

    border-radius:50%;

    padding:4px 8px;

    font-size:12px;

    display:none;

}

    </style>

</head>
<body>

    <a href="/conversations">

    💬 Conversations

    <span id="notif-count">0</span>

</a>
<h2>📅 Ajouter un événement</h2>

<form
    class="event-form"
    method="POST"
    action="/add-event"
>

    <input
        type="hidden"
        name="user"
        value="<%= user.nom %>"
    >

    <input
        type="text"
        name="title"
        placeholder="Titre"
        required
    >

    <input
        type="text"
        name="description"
        placeholder="Description"
        required
    >

    <input
        type="datetime-local"
        name="date"
        required
    >

    <button type="submit">
        Ajouter l'événement
    </button>

</form>

<h2>🎉 Événements</h2>

<div class="events-container">

    <% events.forEach(event => { %>

        <div class="event-card">

            <div class="event-title">
                <%= event.title %>
            </div>

            <div class="event-description">
                <%= event.description %>
            </div>

            <div class="event-user">
                👤 Par : <%= event.user_name %>
            </div>

            <div class="event-date">
                🕒
                <%= new Date(event.date).toLocaleString() %>
            </div>

        </div>

    <% }) %>

</div>

<footer>
    LA GRANDE FAMILLE KOUAME
</footer>

</body>
</html>