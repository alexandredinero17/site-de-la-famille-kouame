<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Membres</title>
    <link rel="stylesheet" href="/css/style.css">

<style>

body{
    margin:0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #0b141a, #0f1c24);
    color:#e9f1f1;
}

/* HEADER */
header{
    background: rgba(32, 44, 51, 0.9);
    backdrop-filter: blur(10px);
    padding:25px;
    text-align:center;
    font-size:22px;
    font-weight:bold;
    letter-spacing:1px;
    border-bottom:1px solid rgba(255,255,255,0.05);
}

/* CONTAINER */
.container{
    width:95%;
    max-width:1200px;
    margin:auto;
    padding:30px 0;
}

/* GRID */
.members-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(280px,1fr));
    gap:22px;
}

/* CARD */
.card{
    background: rgba(32, 44, 51, 0.85);
    border:1px solid rgba(255,255,255,0.05);
    border-radius:18px;
    padding:20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.35);
    transition: all 0.3s ease;
    position:relative;
    overflow:hidden;
}

.card::before{
    content:'';
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:3px;
    background: linear-gradient(90deg, #00a884, #25D366);
}

.card:hover{
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.5);
}

/* TOP */
.top{
    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:15px;
}

.avatar{
    width:70px;
    height:70px;
    border-radius:50%;
    object-fit:cover;
    border:3px solid #00a884;
    box-shadow:0 0 15px rgba(0,168,132,0.4);
}

/* TEXT */
h2{
    margin:0;
    font-size:18px;
}

.username{
    color:#00a884;
    font-size:13px;
    margin-top:3px;
}

/* INFO */
.info p{
    margin:6px 0;
    font-size:14px;
    color:#cfd8dc;
}

.info strong{
    color:#ffffff;
}

/* STATUS */
.status{
    font-size:12px;
    margin-top:5px;
    padding:4px 10px;
    border-radius:20px;
    display:inline-block;
    width:fit-content;
}

.online{
    background: rgba(37, 211, 102, 0.15);
    color:#25D366;
}

.offline{
    background: rgba(255,255,255,0.05);
    color:#aaa;
}

/* ACTIONS */
.actions{
    display:flex;
    gap:10px;
    margin-top:18px;
}

/* BUTTONS */
.actions a{
    flex:1;
    text-align:center;
    padding:10px;
    border-radius:25px;
    text-decoration:none;
    font-weight:600;
    font-size:14px;
    transition:0.3s;
}

/* CHAT */
.btn-chat{
    background: linear-gradient(135deg, #00a884, #01916f);
    color:white;
}

.btn-chat:hover{
    transform:scale(1.05);
    box-shadow:0 5px 15px rgba(0,168,132,0.4);
}

/* WHATSAPP */
.btn-wa{
    background: linear-gradient(135deg, #25D366, #1ebe5d);
    color:white;
}

.btn-wa:hover{
    transform:scale(1.05);
    box-shadow:0 5px 15px rgba(37,211,102,0.4);
}

/* FOOTER */
footer{
    text-align:center;
    padding:25px;
    margin-top:40px;
    background: rgba(32, 44, 51, 0.9);
    font-size:13px;
    color:#aaa;
    border-top:1px solid rgba(255,255,255,0.05);
}

/* NOTIF */
#notif-count{
    background:#ff3b30;
    color:white;
    border-radius:50%;
    padding:3px 7px;
    font-size:11px;
    display:none;
}

</style>

</head>
     <a href="/">Accueil</a>
<body>
<a href="/conversations">

    💬 Conversations

    <span id="notif-count">0</span>

</a>
<header>
    <h1>👨‍👩‍👧‍👦 Nos Membres</h1>
</header>

<div class="container">

    <div class="members-grid">

        <% membres.forEach(membre => { %>

        <div class="card">

            <div class="top">

                <img class="avatar"
                     src="<%= membre.photo || '/images/default.png' %>?t=<%= Date.now() %>">

                <div>
                    <h2><%= membre.nom %></h2>

                    <div class="username">
                        @<%= membre.username %>
                    </div>
                    <div id="status-<%= membre.id %>" class="status">
                        <%= membre.online ? "🟢 En ligne" : "⚫ Hors ligne" %>
                    </div>

            </div>

            <div class="info">

                <p>
                    <strong>Profession :</strong>
                    <%= membre.profession || 'Non renseignée' %>
                </p>

                <p>
                    <strong>Branche :</strong>
                    <%= membre.branche || 'Non renseignée' %>
                </p>

                <p>
                    <%= membre.description || 'Aucune description' %>
                </p>

            </div>

            <div class="actions">

                <% if(user.username !== membre.username){ %>


<a class="btn-chat" href="/chat/<%= membre.username %>" onclick="this.innerText='Chargement...'">
    💬 Discuter
</a>


<% } %>

               <% if(membre.telephone){ %>

<a class="btn-wa" target="_blank" href="https://wa.me/225<%=membre.telephone.replace(/\D/g, '') %>">

   📲 WhatsApp

</a>
                <% } %>

            </div>

        </div>

        <% }) %>

    </div>

</div>


<footer>
    LA GRANDE FAMILLE KOUAME
</footer>
<script>
    const socket = io();

socket.on("user_status", (data) => {

    const statusEl = document.getElementById("status-" + data.userId);

    if (!statusEl) return;

    if (data.online) {

        statusEl.innerText = "🟢 En ligne";
        statusEl.classList.add("online");
        statusEl.classList.remove("offline");

    } else {

        statusEl.innerText = "⚫ Hors ligne";
        statusEl.classList.add("offline");
        statusEl.classList.remove("online");
    }
});
socket.on("disconnect", async () => {

    await db.query(
        "UPDATE users SET online=false,last_seen=NOW() WHERE id=$1",
        [socket.userId]
    );

    io.emit("user_status", {
        userId: socket.userId,
        online: false,
        lastSeen: new Date()
    });

});
if (!data.online) {
    statusEl.innerText = "Vu récemment";
}
    </script>
</body>
</html>