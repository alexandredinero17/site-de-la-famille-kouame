
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Membres</title>
    <link rel="stylesheet" href="/css/style.css">
    
</head>
<style>
    .actions{
    display:flex;
    gap:10px;
}

.btn-chat{
    background:#00a884;
    color:white;
    padding:8px 12px;
    border-radius:20px;
    text-decoration:none;
    font-size:14px;
}

.btn-wa{
    background:#25D366;
    color:white;
    padding:8px 12px;
    border-radius:20px;
    text-decoration:none;
    font-size:14px;
}
</style>
<body>

<header>
    <h1>Nos Membres</h1>
</header>
       <div class="container">

    <% membres.forEach(membre => { %>

 <div class="card" style="display:flex;align-items:center;gap:15px;">

    <img class="avatar"
         src="<%= membre.photo || '/images/default.png' %>?t=<%= Date.now() %>">

            <h2><%= membre.nom %></h2>

            <p><strong>Email :</strong> <%= membre.email %></p>

            <p><strong>Téléphone :</strong> <%=membre.telephone %></p>

            <p><strong>Profession :</strong> <%= membre.profession %></p>

            <p><strong>Branche :</strong> <%= membre.branche %></p>

            <p><%= membre.description %></p>
      
      
     <div class="actions">

        <!-- 💬 CHAT INTERNE -->
        <a class="btn-chat" href="/chat/<%= user.username %>">
            💬 Discuter
        </a>

        <!-- 📲 WHATSAPP -->
        <% if(user.telephone) { %>
        <a class="btn-wa"
           target="_blank"
           href="https://wa.me/<%= user.telephone.replace('+','') %>">
            📲 WhatsApp
        </a>
        <% } %>

    </div>
<% }) %>
<footer>
    LA GRANDE FAMILLE KOUAME
</footer>

</body>
</html>
