</style>



<div class="container">

    <div class="sidebar">

        <div class="sidebar-header">
            <h2>💬 Discussions</h2>
        </div>

       <div class="chat-list">

    <% conversations.forEach(conv => { %>

        <a href="/chat/<%= conv.other.username %>">

            <div class="chat-item">

                <div class="avatar">

                    <img
                        src="<%= conv.other.photo || '/images/default.png' %>"
                        width="50"
                        height="50"
                        style="border-radius:50%"
                    >

                </div>

                <div class="chat-info">

                    <div class="chat-name">

                        <%= conv.other.nom %>

                    </div>

                    <% if(conv.other.online){ %>

                        <small style="color:#25D366">
                            En ligne
                        </small>

                    <% } else { %>

                        <small style="color:gray">
                            Hors ligne
                        </small>

                    <% } %>

                </div>

            </div>

        </a>

    <% }) %>

</div>

    </div>

    <div class="empty">
        Sélectionnez une conversation
    </div>