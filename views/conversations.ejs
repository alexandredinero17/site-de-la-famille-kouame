<div class="container">

    <div class="sidebar">

        <div class="sidebar-header">
            <h2>💬 Discussions</h2>
        </div>

        <div class="chat-list">

            <% conversations.forEach(conv => { %>

                <a href="/chat/<%= conv.other.username %>">

                    <div class="chat-item">

                        <div class="avatar">
                            <img src="<%= conv.other.photo %>" width="50" height="50" style="border-radius:50%">
                        </div>

                        <div class="chat-info">

                            <div class="chat-top">
                                <div class="chat-name">
                                    <%= conv.other.nom %>
                                </div>
                            </div>

                        </div>

                    </div>

                </a>

            <% }) %>

        </div>

    </div>

    <div class="empty">
        👈 Sélectionne une conversation
    </div>

</div>